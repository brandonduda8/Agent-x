# =============================================================================
# Zangi Communication Layer — Environment Variable Template
# =============================================================================
# Copy this file to .env (or merge into your existing .env) and fill in real
# values before starting the services.
#
# DO NOT commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Zangi API credentials
# (obtain from your Zangi developer portal / account)
# -----------------------------------------------------------------------------
ZANGI_API_KEY=your-zangi-api-key-here
ZANGI_API_SECRET=your-zangi-api-secret-here
ZANGI_APP_ID=your-zangi-app-id-here
ZANGI_BASE_URL=https://api.zangi.com/v1

# -----------------------------------------------------------------------------
# Webhook security
# Set to the HMAC secret configured in the Zangi developer portal.
# If left blank, signature verification is skipped (development only).
# -----------------------------------------------------------------------------
ZANGI_WEBHOOK_SECRET=your-zangi-webhook-hmac-secret

# -----------------------------------------------------------------------------
# Shared broadcast channel
# The Zangi group channel ID used for system-wide broadcasts to all agents.
# -----------------------------------------------------------------------------
ZANGI_BROADCAST_CHANNEL_ID=zangi-chan-broadcast-xxxx

# -----------------------------------------------------------------------------
# Per-agent Zangi user IDs
# Each worker agent has a corresponding Zangi user account.
# -----------------------------------------------------------------------------
ZANGI_USER_ORCHESTRATOR=zangi-uid-orchestrator-xxxx
ZANGI_USER_CONTENT_GENERATOR=zangi-uid-content-generator-xxxx
ZANGI_USER_DATA_AGGREGATOR=zangi-uid-data-aggregator-xxxx
ZANGI_USER_PUBLISHER=zangi-uid-publisher-xxxx
ZANGI_USER_INFRASTRUCTURE=zangi-uid-infrastructure-xxxx
ZANGI_USER_API_SOCKET=zangi-uid-api-socket-xxxx
ZANGI_USER_WATCHDOG=zangi-uid-watchdog-xxxx

# -----------------------------------------------------------------------------
# Per-agent Zangi channel IDs
# Each worker agent has a dedicated private channel for targeted messaging.
# Leave blank to fall back to direct user messaging.
# -----------------------------------------------------------------------------
ZANGI_CHANNEL_ORCHESTRATOR=zangi-chan-orchestrator-xxxx
ZANGI_CHANNEL_CONTENT_GENERATOR=zangi-chan-content-generator-xxxx
ZANGI_CHANNEL_DATA_AGGREGATOR=zangi-chan-data-aggregator-xxxx
ZANGI_CHANNEL_PUBLISHER=zangi-chan-publisher-xxxx
ZANGI_CHANNEL_INFRASTRUCTURE=zangi-chan-infrastructure-xxxx
ZANGI_CHANNEL_API_SOCKET=zangi-chan-api-socket-xxxx
ZANGI_CHANNEL_WATCHDOG=zangi-chan-watchdog-xxxx

# -----------------------------------------------------------------------------
# Zangi Webhook Listener (standalone service)
# -----------------------------------------------------------------------------
ZANGI_LISTENER_PORT=3002

# Internal URL of agent-x-core — used by the standalone listener to forward tasks
AGENT_X_CORE_URL=http://localhost:3000

# Path to the agent map JSON file (defaults to data/zangi-agent-map.json)
# ZANGI_MAP_FILE=/absolute/path/to/zangi-agent-map.json

# -----------------------------------------------------------------------------
# Debug
# Set to "true" to log all Zangi API requests and responses
# -----------------------------------------------------------------------------
ZANGI_DEBUG=false
